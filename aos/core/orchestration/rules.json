{
  "meta": {
    "name": "default_orchestration_rules",
    "version": "1.0",
    "note": "Team formation rules (R1-R10, C1-C7) ported from the old rules.yaml. The content layer may override this at content/policies/orchestration.json."
  },
  "activation_rules": {
    "domain_threshold": 2,
    "trigger_on_hard": true,
    "trigger_intents": ["architecture"],
    "never_trigger_intents": ["learning"]
  },
  "team_rules": {
    "cross_domain_augment": true,
    "architecture_include_system_architect": true,
    "database_include_engineer": true,
    "retrieval_keywords": ["rag", "retrieval", "vector", "检索", "向量", "embedding", "knowledge"],
    "llm_keywords": ["llm", "大模型", "model", "模型", "fine-tune", "inference"],
    "distributed_include": true,
    "frontend_include_architect": true,
    "review_include": false,
    "security_include": true,
    "testing_include": true
  },
  "conflict_rules": {
    "single_lead": true,
    "prune_unknown_roles": true,
    "max_team_size": 7,
    "record_pruned": true
  },
  "domain_lead_map": {
    "backend": "backend-architect",
    "frontend": "frontend-architect",
    "database": "database-engineer",
    "security": "security-engineer",
    "distributed": "distributed-system",
    "ai": "llm-engineer",
    "devops": "devops-engineer",
    "architecture": "system-architect",
    "testing": "testing-engineer",
    "data": "database-engineer"
  },
  "intent_role_map": {
    "security": ["security-engineer"],
    "testing": ["testing-engineer"],
    "architecture": ["system-architect", "technical-reviewer"],
    "review": ["code-reviewer", "technical-reviewer"]
  }
}
