#!/usr/bin/env bash
# Agent OS CLI entry point.
#
# Thin shim: resolve the repository root, make the `aos` package importable,
# and hand off to the Python CLI. All logic lives in `aos/cli/`.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export AGENT_OS_ROOT="${AGENT_OS_ROOT:-$REPO_ROOT}"
export PYTHONPATH="$REPO_ROOT${PYTHONPATH:+:$PYTHONPATH}"

exec python3 -m aos.cli "$@"
